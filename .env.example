# PayPal Checkout — Dominion Books
# Copy to Vercel → Project → Settings → Environment Variables
# (Do not commit real secrets.)

# Required — from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# sandbox | live
PAYPAL_MODE=sandbox

# Optional — public site URL (defaults to request host)
# SITE_URL=https://your-domain.vercel.app

# Optional — email Howard on each paid order (Resend.com)
# ORDER_NOTIFY_EMAIL=howard@example.com
# ORDER_NOTIFY_FROM=Dominion Books <orders@yourdomain.com>
# RESEND_API_KEY=re_xxx
