# PayPal Checkout — Dominion Books
# Copy to Vercel → Project → Settings → Environment Variables
# (Do not commit real secrets.)

# Required — from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret

# sandbox | live
PAYPAL_MODE=sandbox

# Email Howard on paid orders + contact-form messages (Resend.com)
# See RESEND.md — verify howardwilliamsbooks.com, then set:
ORDER_NOTIFY_EMAIL=pastorhlw@gmail.com
ORDER_NOTIFY_FROM=Dominion Books <orders@howardwilliamsbooks.com>
RESEND_API_KEY=re_xxx

# Optional — public site URL
# SITE_URL=https://howardwilliamsbooks.com
